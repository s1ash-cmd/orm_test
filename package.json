{
  "name": "orm_test",
  "version": "1.0.0",
  "description": "Сравнение ORM и прямого SQL в C#, Go, TypeScript и Python. Графики, примеры кода и повторение измерений.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3011",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3011",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "engines": { "node": ">=22.0.0" },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "0.561.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "5.9.3"
  }
}
